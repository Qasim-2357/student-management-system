APP_ENV=development

DATABASE_URL=postgresql+psycopg2://<database-user>:<database-password>@localhost:5432/<database-name>

POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<database-password>
POSTGRES_DB=<database-name>

JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Student Performance Analysis (optional feature)
# The app starts and all other features work normally without these set.
# Only the /students/{id}/performance/analysis endpoint requires them.
AI_PROVIDER_API_KEY=<your-openrouter-api-key>
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_PROVIDER_MODEL=openrouter/free
AI_PROVIDER_TIMEOUT_SECONDS=20